{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnostics-plant.v1.json",
  "title": "Diagnostics block gateways[].plant and views_without_cloud[].plant (schema 49)",
  "description": "The plant model of one gateway: components with type number, place, version, hardware type, product name, update type, software identifier and article number; the reported type values; the gate of the hybrid manager rule; the plant kind with its evidence and conflicts. Never serial numbers, UUIDs, the No field, gateway or entry IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_version",
    "table_version",
    "table_available",
    "plant_kind",
    "fuel",
    "cascade",
    "evidence",
    "conflicts",
    "inputs",
    "gates",
    "components_source",
    "components",
    "unmapped_components",
    "sources",
    "stored",
    "restored",
    "stored_age_seconds",
    "changes",
    "probes"
  ],
  "properties": {
    "model_version": {
      "type": "integer",
      "minimum": 1
    },
    "table_version": {
      "type": [
        "integer",
        "null"
      ]
    },
    "table_available": {
      "type": "boolean"
    },
    "plant_kind": {
      "enum": [
        "heat_pump",
        "hybrid",
        "boiler",
        "ventilation",
        "none",
        null
      ]
    },
    "fuel": {
      "enum": [
        "gas",
        "oil",
        "unknown",
        null
      ]
    },
    "cascade": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "enum": [
          "reported_system_type",
          "reported_heat_source_type",
          "reported_heat_pump_type",
          "reported_outdoor_status",
          "hybrid_manager_component",
          "heat_source_types_combined",
          "hybrid_resources",
          "hybrid_manager_signals",
          "stored"
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "enum": [
          "system_type_vs_heat_source_type",
          "components_vs_outdoor_status",
          "heat_pump_component_on_boiler_plant",
          "hybrid_name_rule_only",
          "hybrid_evidence_vs_outdoor_status",
          "cloud_local_components_differ",
          "unknown_type_value",
          "component_rule_skipped"
        ]
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_type",
        "heat_source_types",
        "heat_sources_type",
        "heat_pump_types",
        "bus",
        "outdoor_status",
        "hybrid_evidence",
        "allowed_values",
        "gateway_class",
        "gateway_firmware",
        "platform",
        "restored"
      ],
      "properties": {
        "system_type": {
          "$ref": "#/$defs/token"
        },
        "heat_source_types": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,48}$"
          }
        },
        "heat_sources_type": {
          "$ref": "#/$defs/token"
        },
        "heat_pump_types": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,48}$"
          }
        },
        "bus": {
          "$ref": "#/$defs/token"
        },
        "outdoor_status": {
          "$ref": "#/$defs/token"
        },
        "hybrid_evidence": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "enum": [
              "hybrid_manager_signals",
              "hybrid_resources",
              "system_type",
              "heat_source_type"
            ]
          }
        },
        "allowed_values": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,48}$"
            }
          }
        },
        "gateway_class": {
          "$ref": "#/$defs/token"
        },
        "gateway_firmware": {
          "$ref": "#/$defs/text"
        },
        "platform": {
          "$ref": "#/$defs/token"
        },
        "restored": {
          "type": "array",
          "items": {
            "enum": [
              "components",
              "gateway_firmware",
              "system_type",
              "heat_source_types",
              "heat_sources_type",
              "heat_pump_types",
              "bus",
              "outdoor_status",
              "hybrid_evidence"
            ]
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hybrid_manager_place": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "components_source": {
      "enum": [
        "cloud",
        "local",
        null
      ]
    },
    "components": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "unmapped_components": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "token",
          "count"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/number"
          },
          "token": {
            "$ref": "#/$defs/number"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cloud": {
          "$ref": "#/$defs/source"
        },
        "local": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "stored": {
      "type": "boolean"
    },
    "restored": {
      "type": "boolean"
    },
    "stored_age_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "changes": {
      "type": "integer",
      "minimum": 0
    },
    "probes": {
      "type": "array",
      "maxItems": 48,
      "items": {
        "$ref": "#/$defs/probe"
      }
    },
    "component_devices": {
      "description": "The optional component devices of the gateway (configuration entry diagnostics only): whether the option is on and how many component devices the gateway has.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "count"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "token": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.-]{1,48}$"
    },
    "text": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "reason",
        "gateway_class",
        "platform",
        "gateway_firmware",
        "firmware_minimum",
        "firmware_passed",
        "hybrid_place_rows",
        "first_type",
        "first_version",
        "version_minimum",
        "version_passed"
      ],
      "properties": {
        "result": {
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "reason": {
          "enum": [
            null,
            "no_hybrid_place",
            "table_unavailable",
            "not_a_hybrid_manager",
            "platform",
            "firmware",
            "version"
          ]
        },
        "gateway_class": {
          "$ref": "#/$defs/token"
        },
        "platform": {
          "$ref": "#/$defs/token"
        },
        "gateway_firmware": {
          "$ref": "#/$defs/text"
        },
        "firmware_minimum": {
          "$ref": "#/$defs/text"
        },
        "firmware_passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "hybrid_place_rows": {
          "type": "integer",
          "minimum": 0
        },
        "first_type": {
          "$ref": "#/$defs/number"
        },
        "first_version": {
          "$ref": "#/$defs/text"
        },
        "version_minimum": {
          "$ref": "#/$defs/text"
        },
        "version_passed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "probe": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean",
          "null"
        ],
        "pattern": "^[A-Za-z0-9_./{}%:-]{1,96}$"
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "token",
        "place",
        "place_name",
        "name",
        "role",
        "basis",
        "gateway",
        "version",
        "hardware_type",
        "product_name",
        "has_product_name",
        "sw_update_type",
        "sw_ident",
        "article_number"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/number"
        },
        "token": {
          "$ref": "#/$defs/number"
        },
        "place": {
          "$ref": "#/$defs/token"
        },
        "place_name": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "role": {
          "enum": [
            "heat_source",
            "outdoor_unit",
            "hybrid_manager",
            "system_controller",
            "gateway",
            null
          ]
        },
        "basis": {
          "enum": [
            "name",
            "rule",
            "observed",
            "documented",
            null
          ]
        },
        "gateway": {
          "type": "boolean"
        },
        "version": {
          "$ref": "#/$defs/text"
        },
        "hardware_type": {
          "$ref": "#/$defs/text"
        },
        "product_name": {
          "$ref": "#/$defs/text"
        },
        "has_product_name": {
          "type": "boolean"
        },
        "sw_update_type": {
          "$ref": "#/$defs/text"
        },
        "sw_ident": {
          "$ref": "#/$defs/text"
        },
        "article_number": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "rows",
        "components"
      ],
      "properties": {
        "current": {
          "type": "boolean"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "components": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    }
  }
}
